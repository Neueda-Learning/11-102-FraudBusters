pipeline {

    agent any

    environment {
        GIT_URL = 'https://github.com/Neueda-Learning/11-102-FraudBusters.git'
        BRANCH = 'main'
        COMPOSE_DIR = 'FraudBuster'
    }

    stages {

        stage('Checkout Source') {
            steps {
                git branch: "${BRANCH}",
                    url: "${GIT_URL}"
            }
        }

        stage('Stop Existing Containers') {
            steps {
                dir("${COMPOSE_DIR}") {
                    sh 'docker-compose down || true'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir("${COMPOSE_DIR}") {
                    sh 'docker-compose build --no-cache'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir("${COMPOSE_DIR}") {
                    sh 'docker-compose up -d'
                }
            }
        }

        stage('Verify') {
            steps {
                sh 'docker ps'
            }
        }
    }

    post {
        always {
            dir("${COMPOSE_DIR}") {
                sh 'docker-compose ps || true'
            }
        }
    }
}