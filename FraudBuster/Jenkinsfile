pipeline {

    agent any

    environment {
        GIT_URL = 'https://github.com/Neueda-Learning/11-102-FraudBusters.git'
        BRANCH = 'main'
        COMPOSE_FILE = 'FraudBuster/docker-compose.yml'
    }

    stages {

        stage('Checkout Source') {
            steps {
                checkout scm
            }
        }

        stage('Verify Workspace') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'ls -la FraudBuster || true'
            }
        }

        stage('Stop Existing Containers') {
            steps {
                sh 'docker compose -f "$WORKSPACE/${COMPOSE_FILE}" down || true'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker compose -f "$WORKSPACE/${COMPOSE_FILE}" build --no-cache'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker compose -f "$WORKSPACE/${COMPOSE_FILE}" up -d'
            }
        }

        stage('Verify') {
            steps {
                sh 'docker ps'
                sh 'docker compose -f "$WORKSPACE/${COMPOSE_FILE}" ps'
            }
        }
    }

    post {
        always {
            sh 'docker compose -f "$WORKSPACE/${COMPOSE_FILE}" ps || true'
        }
    }
}