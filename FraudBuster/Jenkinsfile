pipeline {

    agent any

    environment {
        GIT_URL = 'https://github.com/Neueda-Learning/11-102-FraudBusters.git'
        BRANCH = 'main'
        PROJECT_DIR = 'FraudBuster'
        COMPOSE_FILE = 'FraudBuster/docker-compose.yml'
    }

    stages {

        stage('Checkout Source') {
            steps {
                git branch: "${BRANCH}", url: "${GIT_URL}"
            }
        }

        stage('Verify Workspace') {
            steps {
                sh 'pwd'
                sh 'ls -la'
                sh 'ls -la FraudBuster || true'
                sh 'test -f FraudBuster/docker-compose.yml'
            }
        }

        stage('Build Backend (Maven)') {
            steps {
                dir('FraudBuster/backend/TransactionMonitoring') {
                    sh 'chmod +x mvnw || true'
                    sh './mvnw clean verify -DskipTests'
                }
            }
        }

        stage('Stop Existing Containers') {
            steps {
                sh 'docker-compose -f ${COMPOSE_FILE} down || true'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker-compose -f ${COMPOSE_FILE} build --no-cache'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker-compose -f ${COMPOSE_FILE} up -d'
            }
        }

        stage('Wait for Health') {
            steps {
                sh 'sleep 30'
            }
        }

        stage('Verify Containers Running') {
            steps {
                sh 'docker-compose -f ${COMPOSE_FILE} ps'
                sh 'docker ps --format "table {{.Names}}\\t{{.Status}}"'
            }
        }
    }

    post {
        always {
            sh 'docker-compose -f ${COMPOSE_FILE} ps || true'
        }
        failure {
            sh 'docker-compose -f ${COMPOSE_FILE} logs --tail=100 || true'
        }
    }
}